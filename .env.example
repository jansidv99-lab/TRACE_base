# Phase 1 – Step 1.1: template for .env — copy to .env and fill in real values.
# .env is git-ignored; this file is committed and must never contain real secrets.

# --- LLM (used from Stage 02) ---
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=your-agent-model
JUDGE_MODEL=your-judge-model-different-from-MODEL
PROMPT_VERSION=v1

# --- Paths (optional; defaults shown) ---
DATA_DIR=project_data
LOG_DIR=logs

# --- GCP deployment (used in Stage 06) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=000000000000
REGION=us-central1
GIT_REPO=https://github.com/<owner>/<repo>.git
